# Use `demo` for the built-in data. Supabase mode never falls back to demo.
EXPO_PUBLIC_APP_MODE=demo

# For local Supabase, run `npm run supabase:start` and copy these values from
# `npm run supabase:status`. For a remote project, use that project's URL and
# publishable key instead. Do not put a service role key in this file or app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
